{
  "name": "naiwa-launcher",
  "productName": "NaiWa Launcher",
  "version": "0.3.8",
  "description": "NaiWa Launcher (奶娃启动器) - a modern Minecraft launcher",
  "author": {
    "name": "奶龙"
  },
  "private": true,
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.main.json && vite build",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "start": "electron .",
    "dist:portable": "node scripts/build-app.mjs --win portable --x64",
    "dist:installer": "node scripts/build-installer.mjs",
    "dist": "node scripts/build-app.mjs && node scripts/build-installer.mjs && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-zip.ps1 && node scripts/build-app.mjs --win portable --x64 && node scripts/copy-single-exe.mjs",
    "dist:app": "node scripts/build-app.mjs",
    "dist:zip": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-zip.ps1"
  },
  "dependencies": {
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "build": {
    "appId": "com.naiwa.launcher",
    "productName": "NaiWa Launcher",
    "copyright": "奶娃启动器 · 开发者 奶龙",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json",
      "!node_modules/react/**",
      "!node_modules/react-dom/**",
      "!node_modules/scheduler/**"
    ],
    "extraResources": [
      {
        "from": "resources/logo.png",
        "to": "logo.png"
      },
      {
        "from": "resources/logo-512.png",
        "to": "logo-512.png"
      },
      {
        "from": "resources/logo.ico",
        "to": "logo.ico"
      },
      {
        "from": "resources/startup-bgm.mp3",
        "to": "startup-bgm.mp3"
      },
      {
        "from": "resources/skins",
        "to": "skins"
      },
      {
        "from": "resources/capes",
        "to": "capes"
      },
      {
        "from": "CHANGELOG.md",
        "to": "CHANGELOG.md"
      }
    ],
    "win": {
      "icon": "resources/logo.ico",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "NaiWaLauncher-${version}-${arch}-${target}.exe"
    },
    "portable": {
      "artifactName": "NaiWaLauncher-${version}-single-exe.exe",
      "unpackDirName": "NaiWaLauncher"
    },
    "asar": false,
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ]
  }
}